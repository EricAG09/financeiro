# ============================================================================
# Finance AI — variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha com valores reais.
# NUNCA faça commit de `.env.local`. NUNCA coloque segredos neste arquivo.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — público (exposto ao browser, protegido por RLS)
# Painel: Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server-side apenas
# ATENÇÃO: a service role key ignora RLS. Jamais prefixar com NEXT_PUBLIC_,
# jamais importar em Client Component, jamais logar.
# Opcional: só preencha quando houver rotina administrativa server-side.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Agente de IA — não utilizado na Etapa 1
# O provedor é abstraído em `lib/ai/provider.ts`. Preencher apenas quando o
# agente for implementado (etapa futura). Server-side apenas.
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
